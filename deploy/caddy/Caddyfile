# Plan section 56. Caddy is the only thing the internet talks to; both processes
# bind loopback and are not reachable from outside.
#
# The name is a variable with a default rather than a literal, because the
# default is admittedly temporary: Forma has no domain of its own yet and
# forma.hintly.online is a subdomain borrowed from one that exists. Set
# FORMA_DOMAIN in /etc/forma/domain.env to move it without editing this file on
# the machine — the systemd drop-in in deploy/systemd/caddy.service.d is what
# puts that variable into Caddy's environment, since Caddy does not read
# forma.env and must not be handed the token it contains.
#
# Caddy issues and renews the certificate itself, which needs the name resolving
# here and port 80 reachable before it first runs.

{$FORMA_DOMAIN:forma.hintly.online} {
	encode zstd gzip

	# OAuth clients fetch this before they have a bearer. It is a forma-mcp
	# route, and unlike /mcp its canonical path must arrive unchanged.
	handle /.well-known/oauth-protected-resource/mcp {
		reverse_proxy 127.0.0.1:4766
	}

	# MCP over Streamable HTTP. The bearer token is checked by forma-mcp
	# itself, not here: this is a proxy, and putting the credential in two
	# places is how they drift apart.
	handle /mcp* {
		uri strip_prefix /mcp
		reverse_proxy 127.0.0.1:4766 {
			# An MCP session streams; a read timeout would cut a long
			# render off mid-flight.
			flush_interval -1
		}
	}

	# The Pontis UI action channel (Pontis plan section 10(b) D9). Routed here
	# so the editor and these three routes share an origin: the sidecar's
	# transport refuses a cross-origin Origin and validates Host against the
	# same list, which is its DNS-rebinding defence, and the editor's bearer
	# travels in a header rather than a query string because of it.
	#
	# Only /pons/v1/ui/*. The gateway hop the agent runtime uses is not a
	# browser route and is not exposed here.
	handle /pons/v1/ui/* {
		reverse_proxy 127.0.0.1:4767 {
			# Server-Sent Events. Buffering would hold a UI action until a
			# buffer filled, which is the difference between the person's
			# canvas moving now and moving a minute from now.
			flush_interval -1
		}
	}

	# The REST API and the built editor, from one origin (plan section 58).
	handle {
		reverse_proxy 127.0.0.1:4765
	}

	# Access logs go to stderr, which systemd captures into the journal:
	# `journalctl -u caddy`. It rotates on its own and is where you look on a
	# systemd box anyway.
	#
	# This used to write /var/log/caddy/forma.log and that was a mistake. Caddy
	# creates a log file 0600 owned by whoever opened it, `caddy validate` runs
	# as root, and the service then runs as `caddy` and cannot reopen its own
	# log — so the deploy validated cleanly and the service died on start. If
	# you do want a file here, create it owned by `caddy` first; the journal is
	# simpler and gives up nothing.
	log {
		output stderr
	}
}
