# Copy to /etc/forma/forma.env, chmod 600, owned by root.
#
# FORMA_REMOTE_TOKEN is what makes a non-loopback bind legal: forma-server
# refuses to start reachable from the network without one, and forma-mcp
# refuses --transport http without one. Generate it on the machine:
#
#   openssl rand -base64 48

FORMA_REMOTE_TOKEN=replace-me

# The public name Caddy serves and issues a certificate for. Temporary: Forma
# has no domain of its own yet, so this is a subdomain of one that exists.
# Changing it here and reloading Caddy is the whole move.
FORMA_DOMAIN=forma.hintly.online

FORMA_BIND=127.0.0.1:4765
FORMA_MCP_BIND=127.0.0.1:4766
FORMA_SERVER_URL=http://127.0.0.1:4765

FORMA_DATA_DIR=/var/lib/forma
FORMA_DATABASE_URL=sqlite:///var/lib/forma/forma.db
FORMA_FONT_DIR=/var/lib/forma/fonts
FORMA_WEB_DIR=/opt/forma/web
FORMA_LOG=info
