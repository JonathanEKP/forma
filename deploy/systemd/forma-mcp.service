[Unit]
Description=Forma MCP over Streamable HTTP
# It is a client of forma-server's REST API, never of the database, so it is
# useless without it (plan section 5).
After=forma-server.service
Requires=forma-server.service

[Service]
Type=exec
User=forma
Group=forma
EnvironmentFile=/etc/forma/forma.env
# The public name too: rmcp validates the inbound Host header, and behind Caddy
# that header is the domain rather than loopback. One source of truth for the
# name, shared with Caddy, rather than the same value in two files.
EnvironmentFile=/etc/forma/domain.env
ExecStart=/opt/forma/forma-mcp --transport http
WorkingDirectory=/var/lib/forma
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# It writes nothing: the design database is reached over HTTP.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
