# Copy to /etc/forma/domain.env. Readable by root; it holds no secret.
#
# The public name Caddy serves and issues a certificate for. Temporary: Forma has
# no domain of its own yet, so this is a subdomain of one that exists.
#
# Changing it: edit here, `systemctl restart caddy`, and Caddy issues a
# certificate for the new name on its own. Then repoint any MCP client.
FORMA_DOMAIN=forma.hintly.online
