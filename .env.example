# Copy to .env and adjust. All values have working defaults, so an empty file
# still runs a local Forma.

# Plan section 70: local-only by default. Never bind 0.0.0.0 unless you mean it.
FORMA_BIND=127.0.0.1:4765
FORMA_DATA_DIR=./data
FORMA_DATABASE_URL=sqlite://data/forma.db
FORMA_FONT_DIR=./data/fonts
FORMA_LOG=info

# Directory of the built React app, served by forma-server when present.
FORMA_WEB_DIR=./apps/web/dist

# Read by forma-mcp to reach forma-server.
FORMA_SERVER_URL=http://127.0.0.1:4765
