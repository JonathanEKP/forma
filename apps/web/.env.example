# Copy to .env and fill in for a hosted deployment (plan section 114.1).
#
# Both values are public by design. Vite bakes VITE_* into the bundle at build
# time rather than reading them at runtime, so whatever is here reaches every
# visitor's browser. That is fine for these two and is why they are the only
# Supabase values the frontend ever sees.
#
# It also means the build machine needs them: `pnpm build` reads this file, and
# the server's /etc/forma/forma.env does not reach it.
#
# NEVER put an sb_secret_… / service_role key here. Validating user JWTs and
# using the consent APIs do not need one, and anything in this file is public.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local Forma needs neither: with FORMA_AUTH_MODE unset the editor has no
# identity to talk to and goes straight to the workspace.
