# --- Rust ---
/target/
**/*.rs.bk

# --- Node / pnpm ---
node_modules/
.pnpm-store/
apps/web/dist/
*.tsbuildinfo

# --- Forma runtime data ---
# data/fonts/ SI se versiona (ver plan seccion 34: el renderer debe cargar
# las mismas fonts en local, CI, Docker y Oracle).
/data/forma.db
/data/forma.db-shm
/data/forma.db-wal
/data/assets/
/data/previews/
/data/exports/

# --- Config local ---
.env
.env.local
.env.*.local

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- pnpm workspace ---
apps/*/node_modules/

# --- end-to-end ---
e2e/test-results/
e2e/playwright-report/

# The half-finished OAuth flow of scripts/oauth-flow.py: a PKCE verifier and
# the state it is paired with, both single-use and neither ours to publish.
/.oauth-flow.json

# Cross-compiled output for the deploy, rebuilt by scripts/build-aarch64.sh.
# Tracked by mistake once: it is ~28 MB of binaries that churn on every deploy,
# so every deploy dirtied the tree and any `git add -A` swept a new copy in.
# The blobs already in history stay there — removing those is a rewrite, and
# that is the repository owner's call.
/dist/

# --- Pontis sidecar ---
# The one seam to a local Pontis checkout (apps/pontis-sidecar/README.md). A
# symlink to someone's own path, so it is never committed.
apps/pontis-sidecar/.pontis
apps/pontis-sidecar/test-driver/target/

# --- Step 11 real Codex run (docs/pontis-step11-real-codex.md) ---
# Codex 0.158.0 pinned for this run only, and its dedicated CODEX_HOME. The home
# holds a symlink to the owner's auth.json: never committed, never copied.
/.codex-pinned/
